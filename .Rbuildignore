^(?!(DESCRIPTION|NAMESPACE|LICENSE|NEWS\.md)$|(R|man|tests|vignettes|inst|build)(/|$))
^R/(?![^/.][^/]*\.R$)
^man/(?![^/.][^/]*\.Rd$)
^tests/(?!testthat\.R$|testthat(/|$))
^tests/testthat/(?![^/.][^/]*\.R$|_snaps(/|$))
^tests/testthat/_snaps/(?!snapshots\.md$)
^vignettes/(?![^/.][^/]*\.Rmd$)
^inst/(?!CITATION$|examples(/|$)|doc(/|$))
^inst/examples/(?!example_usage\.R$)
^inst/doc/(?![^/.][^/]*\.(R|Rmd|html)$)
^build/(?!vignette\.rds$)
